{
  "manifest_version": 3,
  "name": "WME - RightClick Functions",
  "version": "1.4.26",
  "version_name": "Beta",
  "description": "Right-click tools, Map Pins, Friends sharing, reminders, backups and WME integrations without Tampermonkey.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.waze.com/*",
    "https://beta.waze.com/*",
    "https://w-tools.org/*",
    "https://update.greasyfork.org/*",
    "https://deployable-assets.editorx.dev/*",
    "https://accounts.google.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.waze.com/*/editor*",
        "https://www.waze.com/editor*",
        "https://beta.waze.com/*/editor*",
        "https://beta.waze.com/editor*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.waze.com/*/editor*",
        "https://www.waze.com/editor*",
        "https://beta.waze.com/*/editor*",
        "https://beta.waze.com/editor*"
      ],
      "css": [
        "friends-clean-directory.css"
      ],
      "js": [
        "userscript.js",
        "friends-clean-directory.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.waze.com/*/editor*",
        "https://www.waze.com/editor*",
        "https://beta.waze.com/*/editor*",
        "https://beta.waze.com/editor*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
