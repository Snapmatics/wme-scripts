rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function self(authUid) {
      return signedIn() && request.auth.uid == authUid;
    }

    function hasWmeBinding() {
      return signedIn() &&
        exists(/databases/$(database)/documents/authBindings/$(request.auth.uid));
    }

    function currentWmeId() {
      return hasWmeBinding()
        ? get(/databases/$(database)/documents/authBindings/$(request.auth.uid)).data.wmeUserId
        : '';
    }

    function ownsUserProfile(wmeUserId) {
      return signedIn() &&
        wmeUserId is string &&
        exists(/databases/$(database)/documents/users/$(wmeUserId)) &&
        get(/databases/$(database)/documents/users/$(wmeUserId)).data.authUid ==
          request.auth.uid;
    }

    function ownsWmeId(wmeUserId) {
      return signedIn() &&
        wmeUserId is string &&
        (
          currentWmeId() == wmeUserId ||
          ownsUserProfile(wmeUserId)
        );
    }

    function wmeParticipant(data) {
      return signedIn() &&
        (
          ownsWmeId(data.fromUid) ||
          ownsWmeId(data.toUid)
        );
    }

    // Temporary compatibility with v1.3.x documents and clients.
    function authParticipant(data) {
      return signedIn() &&
        (
          (data.fromAuthUid is string && data.fromAuthUid == request.auth.uid) ||
          (data.toAuthUid is string && data.toAuthUid == request.auth.uid)
        );
    }

    function participant(data) {
      return wmeParticipant(data) || authParticipant(data);
    }

    function acceptedFriendRequest(requestId, uidA, uidB) {
      return requestId is string &&
        exists(/databases/$(database)/documents/friendRequests/$(requestId)) &&
        get(/databases/$(database)/documents/friendRequests/$(requestId)).data.status == 'accepted' &&
        (
          (
            get(/databases/$(database)/documents/friendRequests/$(requestId)).data.fromUid == uidA &&
            get(/databases/$(database)/documents/friendRequests/$(requestId)).data.toUid == uidB
          ) ||
          (
            get(/databases/$(database)/documents/friendRequests/$(requestId)).data.fromUid == uidB &&
            get(/databases/$(database)/documents/friendRequests/$(requestId)).data.toUid == uidA
          )
        );
    }

    /* One Firebase anonymous browser session may bind to one WME user ID. */
    match /authBindings/{authUid} {
      allow read: if self(authUid);

      allow create, update: if self(authUid) &&
        request.resource.data.keys().hasAll([
          'authUid',
          'wmeUserId',
          'wmeUsername',
          'wmeUsernameNormalized',
          'wmeBindingKey',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'authUid',
          'wmeUserId',
          'wmeUsername',
          'wmeUsernameNormalized',
          'wmeBindingKey',
          'updatedAt'
        ]) &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.wmeUserId is string &&
        request.resource.data.wmeUserId.size() > 0 &&
        request.resource.data.wmeUserId.size() <= 64 &&
        request.resource.data.wmeUsername is string &&
        request.resource.data.wmeUsername.size() > 0 &&
        request.resource.data.wmeUsername.size() <= 128 &&
        request.resource.data.wmeUsernameNormalized is string &&
        request.resource.data.wmeUsernameNormalized.size() > 0 &&
        request.resource.data.wmeUsernameNormalized.size() <= 128 &&
        request.resource.data.wmeBindingKey ==
          ('wme-id:' + request.resource.data.wmeUserId) &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if self(authUid);
    }

    /* Public Friends profile. Document ID is the stable numeric WME user ID. */
    match /users/{wmeUserId} {
      allow read: if signedIn();

      allow create, update: if ownsWmeId(wmeUserId) &&
        request.resource.data.keys().hasAll([
          'uid',
          'authUid',
          'wmeUsername',
          'wmeUsernameNormalized',
          'wmeUserId',
          'wmeAvatarUrl',
          'wmeBindingKey',
          'authProvider',
          'accountMode',
          'active',
          'bindingVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'authUid',
          'wmeUsername',
          'wmeUsernameNormalized',
          'wmeUserId',
          'wmeAvatarUrl',
          'wmeBindingKey',
          'authProvider',
          'accountMode',
          'active',
          'bindingVersion',
          'wmeRank',
          'wmeLevel',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == wmeUserId &&
        request.resource.data.wmeUserId == wmeUserId &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.wmeBindingKey == ('wme-id:' + wmeUserId) &&
        request.resource.data.authProvider == 'wme-anonymous' &&
        request.resource.data.accountMode == 'wme-id-direct' &&
        request.resource.data.active == true &&
        request.resource.data.bindingVersion is int &&
        (
          !('wmeRank' in request.resource.data) ||
          (
            request.resource.data.wmeRank is int &&
            request.resource.data.wmeRank >= 0 &&
            request.resource.data.wmeRank <= 10
          )
        ) &&
        (
          !('wmeLevel' in request.resource.data) ||
          (
            request.resource.data.wmeLevel is int &&
            request.resource.data.wmeLevel >= 1 &&
            request.resource.data.wmeLevel <= 11
          )
        ) &&
        request.resource.data.wmeUsername is string &&
        request.resource.data.wmeUsername.size() > 0 &&
        request.resource.data.wmeUsername.size() <= 128 &&
        request.resource.data.wmeUsernameNormalized is string &&
        request.resource.data.wmeUsernameNormalized.size() > 0 &&
        request.resource.data.wmeUsernameNormalized.size() <= 128 &&
        request.resource.data.wmeAvatarUrl is string &&
        request.resource.data.wmeAvatarUrl.size() <= 2048 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if ownsWmeId(wmeUserId);
    }

    match /usernames/{key} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* Requests are owned and queried by stable WME IDs, not browser auth UIDs. */
    match /friendRequests/{requestId} {
      allow get, list: if participant(resource.data);

      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'fromUid',
          'toUid',
          'fromUsername',
          'fromUsernameNormalized',
          'toUsername',
          'toUsernameNormalized',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'fromUid',
          'toUid',
          'fromAuthUid',
          'toAuthUid',
          'fromUsername',
          'fromUsernameNormalized',
          'fromAvatarUrl',
          'toUsername',
          'toUsernameNormalized',
          'toAvatarUrl',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        ownsWmeId(request.resource.data.fromUid) &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid.size() > 0 &&
        request.resource.data.toUid != request.resource.data.fromUid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.toUid)) &&
        request.resource.data.fromUsername is string &&
        request.resource.data.fromUsername.size() > 0 &&
        request.resource.data.fromUsername.size() <= 128 &&
        request.resource.data.fromUsernameNormalized is string &&
        request.resource.data.toUsername is string &&
        request.resource.data.toUsername.size() > 0 &&
        request.resource.data.toUsername.size() <= 128 &&
        request.resource.data.toUsernameNormalized is string &&
        (
          !('fromAvatarUrl' in request.resource.data) ||
          (
            request.resource.data.fromAvatarUrl is string &&
            request.resource.data.fromAvatarUrl.size() <= 2048
          )
        ) &&
        (
          !('toAvatarUrl' in request.resource.data) ||
          (
            request.resource.data.toAvatarUrl is string &&
            request.resource.data.toAvatarUrl.size() <= 2048
          )
        ) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;

      allow update: if signedIn() &&
        (
          ownsWmeId(resource.data.toUid) ||
          (resource.data.toAuthUid is string && resource.data.toAuthUid == request.auth.uid)
        ) &&
        resource.data.status == 'pending' &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]) &&
        request.resource.data.status in ['accepted', 'declined'] &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if participant(resource.data);
    }

    /* Tiny realtime wake-up document keyed by the target WME user ID. */
    match /realtimeSignals/{signalId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'targetUid',
          'eventType',
          'nonce',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'targetUid',
          'eventType',
          'nonce',
          'updatedAt'
        ]) &&
        signalId == request.resource.data.targetUid &&
        request.resource.data.targetUid is string &&
        request.resource.data.targetUid.size() > 0 &&
        request.resource.data.targetUid.size() <= 64 &&
        request.resource.data.eventType is string &&
        request.resource.data.eventType.size() > 0 &&
        request.resource.data.eventType.size() <= 48 &&
        request.resource.data.nonce is string &&
        request.resource.data.nonce.size() > 0 &&
        request.resource.data.nonce.size() <= 80 &&
        request.resource.data.updatedAt is timestamp;

      allow update: if signedIn() &&
        resource.data.targetUid == signalId &&
        request.resource.data.keys().hasOnly([
          'targetUid',
          'eventType',
          'nonce',
          'updatedAt'
        ]) &&
        request.resource.data.targetUid == resource.data.targetUid &&
        request.resource.data.targetUid == signalId &&
        request.resource.data.eventType is string &&
        request.resource.data.eventType.size() > 0 &&
        request.resource.data.eventType.size() <= 48 &&
        request.resource.data.nonce is string &&
        request.resource.data.nonce.size() > 0 &&
        request.resource.data.nonce.size() <= 80 &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    /* Shared pins are also owned and queried by stable WME IDs. */
    match /pinShares/{shareId} {
      allow get, list: if participant(resource.data);

      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'fromUid',
          'toUid',
          'fromUsername',
          'fromUsernameNormalized',
          'toUsername',
          'toUsernameNormalized',
          'friendRequestId',
          'status',
          'createdAt',
          'respondedAt',
          'pin'
        ]) &&
        request.resource.data.keys().hasOnly([
          'fromUid',
          'toUid',
          'fromAuthUid',
          'toAuthUid',
          'fromUsername',
          'fromUsernameNormalized',
          'toUsername',
          'toUsernameNormalized',
          'friendRequestId',
          'status',
          'createdAt',
          'respondedAt',
          'pin'
        ]) &&
        ownsWmeId(request.resource.data.fromUid) &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid.size() > 0 &&
        request.resource.data.toUid != request.resource.data.fromUid &&
        request.resource.data.fromUsername is string &&
        request.resource.data.fromUsernameNormalized is string &&
        request.resource.data.toUsername is string &&
        request.resource.data.toUsernameNormalized is string &&
        request.resource.data.friendRequestId is string &&
        acceptedFriendRequest(
          request.resource.data.friendRequestId,
          request.resource.data.fromUid,
          request.resource.data.toUid
        ) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.respondedAt == null &&
        request.resource.data.pin is map &&
        request.resource.data.pin.keys().hasAll([
          'name',
          'note',
          'lat',
          'lon',
          'color',
          'folderName'
        ]) &&
        request.resource.data.pin.keys().hasOnly([
          'name',
          'note',
          'lat',
          'lon',
          'color',
          'folderName'
        ]) &&
        request.resource.data.pin.name is string &&
        request.resource.data.pin.note is string &&
        request.resource.data.pin.lat is number &&
        request.resource.data.pin.lon is number &&
        request.resource.data.pin.color is string &&
        request.resource.data.pin.folderName is string;

      allow update: if false;
      allow delete: if participant(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
