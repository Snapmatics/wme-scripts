function clusterByPixel(items, distPx) {
  const dist = Math.max(18, Number(distPx) || 36);
  const dist2 = dist * dist;
  const remaining = (Array.isArray(items) ? items : [])
    .filter((it) => it && it.id != null && it.px && Number.isFinite(Number(it.px.x)) && Number.isFinite(Number(it.px.y)))
    .slice();
  const out = [];

  while (remaining.length) {
    const cluster = [remaining.shift()];
    let changed = true;

    // Grow around the live centroid instead of only comparing to the first item.
    // This prevents zoomed-out pins from splitting into too many small bubbles.
    while (changed) {
      changed = false;
      let cx = 0, cy = 0;
      for (const it of cluster) {
        cx += Number(it.px.x);
        cy += Number(it.px.y);
      }
      cx /= cluster.length;
      cy /= cluster.length;

      for (let i = remaining.length - 1; i >= 0; i--) {
        const b = remaining[i];
        const dx = Number(b.px.x) - cx;
        const dy = Number(b.px.y) - cy;
        if ((dx * dx + dy * dy) <= dist2) {
          cluster.push(b);
          remaining.splice(i, 1);
          changed = true;
        }
      }
    }

    out.push(cluster);
  }

  return out;
}

