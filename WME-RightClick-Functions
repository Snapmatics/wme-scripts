function findDisplayCheckboxContainer() {
  const wanted = [
    /Satellite\s+imagery/i,
    /Online\s+editors/i,
    /GPS\s+points/i,
    /Map\s+notes/i,
    /Cities/i,
    /Display/i,
  ];

