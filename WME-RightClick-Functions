    const loaded = getAllLoadedSegmentsW();
    const matchIds = [];
    for (const s of loaded) {
      if (primaryStreetIdFromW(s) == streetId) {
        const id = segIdFromW(s);
        if (Number.isFinite(id)) matchIds.push(id);
