  if (z >= 11) return 76;
  if (z >= 10) return 94;
  if (z >= 9) return 112;
  if (z >= 8) return 132;
  return 154;
}

function getClusterLonLatFromItems(items, map, ol) {
  try {
    const arr = Array.isArray(items) ? items.filter(Boolean) : [];
    if (!arr.length) return null;

    let pxSumX = 0, pxSumY = 0, pxCount = 0;
    for (const it of arr) {
      if (it && it.px && Number.isFinite(Number(it.px.x)) && Number.isFinite(Number(it.px.y))) {
        pxSumX += Number(it.px.x);
        pxSumY += Number(it.px.y);
        pxCount++;
      }
    }

    if (pxCount && map && ol && typeof map.getLonLatFromLayerPx === "function" && typeof ol.Pixel === "function") {
      const ll = map.getLonLatFromLayerPx(new ol.Pixel(pxSumX / pxCount, pxSumY / pxCount));
      if (ll && Number.isFinite(Number(ll.lon)) && Number.isFinite(Number(ll.lat))) return ll;
    }

    let lonSum = 0, latSum = 0, llCount = 0;
    for (const it of arr) {
      const ll = it && it.ll;
      if (ll && Number.isFinite(Number(ll.lon)) && Number.isFinite(Number(ll.lat))) {
        lonSum += Number(ll.lon);
        latSum += Number(ll.lat);
        llCount++;
      }
    }

    if (llCount && ol && typeof ol.LonLat === "function") {
      return new ol.LonLat(lonSum / llCount, latSum / llCount);
    }
  } catch {}
  return null;
}

function getClusterPixelFromItems(items) {
  try {
    const arr = Array.isArray(items) ? items.filter(Boolean) : [];
