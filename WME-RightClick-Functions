        const id = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
        const newPin = { id, name, color: chosenColor, mapSymbol: "default", groupId: chosenGroupId, lon: Number(ll.lon), lat: Number(ll.lat), zoom: Number.isFinite(zoom) ? zoom : null, createdAt: Date.now(), reminderAt, reminderDone: false, reminderType: null, reminderUnit: null, reminderValue: null , reminderNote: "", note: "" };

