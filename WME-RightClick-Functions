      clearTimeout(menuState.subCloseTimer);
      menuState.subCloseTimer = null;
    }
  }

  function closeSubMenu2() {
    try { if (menuState.sub2AnchorRow) menuState.sub2AnchorRow.classList.remove("submenuOpen"); } catch {}
