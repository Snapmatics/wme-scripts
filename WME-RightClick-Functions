  function closeSubMenu() {
    closeSubMenu2();
    try { if (menuState.subAnchorRow) menuState.subAnchorRow.classList.remove("submenuOpen"); } catch {}
    menuState.subAnchorRow = null;
    if (menuState.sub) menuState.sub.remove();
    menuState.sub = null;
