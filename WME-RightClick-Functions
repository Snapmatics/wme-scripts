      arr.splice(editIndex, 1);
      saveCustomPinColors(arr);
      customColors = loadCustomPinColors();
      renderCustomSwatches();
      renderStats();
    }
    closePop();
  });


  btnDone.addEventListener('click', (e) => {
    e.preventDefault(); e.stopPropagation();

