    try {
      const info = selectedPlaceInfo();
      const ids = Array.isArray(info?.ids) ? info.ids : [];
      const venuesModel = UW?.W?.model?.venues || UW?.W?.model?.pois || null;
      if (venuesModel && ids.length && typeof venuesModel.getObjectById === "function") {
        for (const id of ids) {
          try {
