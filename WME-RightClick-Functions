  function getExtensionMarketplaceEntries() {
    try {
      const list = UW.WmeRightClickMarketplace;
      if (Array.isArray(list)) {
        return list.filter(Boolean).map((it) => ({
          id: String(it.id || "").trim(),
          name: String(it.name || it.title || it.id || "Unnamed extension"),
          author: String(it.author || ""),
          description: String(it.description || ""),
          installUrl: String(it.installUrl || it.url || "").trim(),
          homepageUrl: String(it.homepageUrl || it.infoUrl || "").trim(),
          version: String(it.version || "").trim(),
          installedVersion: String(it.installedVersion || "").trim(),
          category: String(it.category || "Utilities").trim() || 'Utilities',
          contexts: Array.isArray(it.contexts) ? it.contexts.map((x) => String(x || '').trim().toLowerCase()).filter(Boolean) : [],
          tags: Array.isArray(it.tags) ? it.tags.map((x) => String(x || '').trim()).filter(Boolean) : [],
          screenshots: Array.isArray(it.screenshots) ? it.screenshots.map((x) => String(x || '').trim()).filter(Boolean) : [],
          iconUrl: String(it.iconUrl || '').trim(),
        })).filter((it) => it.id && (it.installUrl || it.homepageUrl || it.name));
      }
    } catch {}
    return [];
  }

  function compareVersionsLoose(a, b) {
    const pa = String(a || '').split(/[^0-9]+/).filter(Boolean).map(Number);
    const pb = String(b || '').split(/[^0-9]+/).filter(Boolean).map(Number);
    const len = Math.max(pa.length, pb.length);
    for (let i = 0; i < len; i++) {
      const av = Number.isFinite(pa[i]) ? pa[i] : 0;
      const bv = Number.isFinite(pb[i]) ? pb[i] : 0;
      if (av > bv) return 1;
      if (av < bv) return -1;
    }
    return 0;
  }

  function getMarketplaceCategoryList(entries) {
    const set = new Set(['All']);
    for (const e of entries) if (e.category) set.add(e.category);
    return Array.from(set);
  }

  function getInstalledGroupMap() {
    const map = new Map();
    for (const g of getGroupedRegisteredExtensions()) map.set(String(g.id || '').trim(), g);
    return map;
  }

  function getEntryStatus(entry, installedGroup) {
    if (!installedGroup) return 'Not installed';
    const enabled = isExtensionGroupEnabled(installedGroup.id);
    if (!enabled) return 'Disabled';
    if (entry && entry.version && entry.installedVersion && compareVersionsLoose(entry.version, entry.installedVersion) > 0) return 'Update available';
    return 'Installed';
  }

