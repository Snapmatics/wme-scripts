function _rcDist2PointToSegment(px, py, ax, ay, bx, by) {
  const abx = bx - ax;
  const aby = by - ay;
  const apx = px - ax;
  const apy = py - ay;
  const ab2 = (abx * abx) + (aby * aby);
  if (!(ab2 > 0)) {
    const dx = px - ax;
    const dy = py - ay;
    return (dx * dx) + (dy * dy);
  }
  let t = ((apx * abx) + (apy * aby)) / ab2;
  if (t < 0) t = 0;
  else if (t > 1) t = 1;
  const cx = ax + (abx * t);
  const cy = ay + (aby * t);
  const dx = px - cx;
  const dy = py - cy;
  return (dx * dx) + (dy * dy);
}

function getClosestStreetNameForLonLat(ll) {
  try {
    if (!ll || !Number.isFinite(Number(ll.lat)) || !Number.isFinite(Number(ll.lon))) return null;
    const segStore = UW?.W?.model?.segments;
    const raw = segStore?.objects || segStore?._objects || null;
    const pool = raw ? Object.values(raw) : [];
    if (!Array.isArray(pool) || !pool.length) return null;

    const px = Number(ll.lon);
    const py = Number(ll.lat);
    let bestSegId = null;
    let bestD2 = Infinity;

    for (const segObj of pool) {
      const segId = Number(segObj?.id ?? segObj?.attributes?.id);
      if (!Number.isFinite(segId)) continue;
      const coords = segmentCoords(segId);
      if (!Array.isArray(coords) || coords.length < 2) continue;
      for (let i = 1; i < coords.length; i += 1) {
        const a = coords[i - 1];
        const b = coords[i];
        const ax = Number(a?.[0]);
        const ay = Number(a?.[1]);
        const bx = Number(b?.[0]);
        const by = Number(b?.[1]);
        if (![ax, ay, bx, by].every(Number.isFinite)) continue;
        const d2 = _rcDist2PointToSegment(px, py, ax, ay, bx, by);
        if (d2 < bestD2) {
          bestD2 = d2;
          bestSegId = segId;
        }
      }
    }

    if (!Number.isFinite(bestD2) || bestSegId == null) return null;
    const sc = getStreetAndCityForSegmentId(bestSegId);
    const street = String(sc?.street || '').trim();
    if (!street || street.startsWith('(')) return null;
    return street;
  } catch {
    return null;
  }
}

