      head.appendChild(titleRow);

      if (sub) {
        const subEl = document.createElement('div');
        subEl.className = 'wmeRcSideSub';
        subEl.textContent = sub;
        head.appendChild(subEl);
      }

      const body = document.createElement('div');
      body.className = 'wmeRcSettingsBody';

      card.appendChild(head);
      card.appendChild(body);
      return { card, body };
    };

    const makeSettingRow = ({ title, desc, control, controlClassName, onRowClick, extra }) => {
      const row = document.createElement('div');
      row.className = 'wmeRcSettingRow';

      const textWrap = document.createElement('div');
      textWrap.className = 'wmeRcSettingText';

      const titleEl = document.createElement('div');
      titleEl.className = 'wmeRcSettingTitle';
      titleEl.textContent = title;
      textWrap.appendChild(titleEl);

      if (desc) {
        const descEl = document.createElement('div');
        descEl.className = 'wmeRcSettingDesc';
        descEl.textContent = desc;
        textWrap.appendChild(descEl);
      }

      if (extra) textWrap.appendChild(extra);

      const controlWrap = document.createElement('div');
      controlWrap.className = 'wmeRcSettingControl' + (controlClassName ? ' ' + controlClassName : '');
      controlWrap.appendChild(control);

      row.appendChild(textWrap);
      row.appendChild(controlWrap);

      if (typeof onRowClick === 'function') {
        row.addEventListener('click', (ev) => {
          if (controlWrap.contains(ev.target)) return;
          try { onRowClick(ev); } catch {}
        });
      }

      return row;
    };

    const linkCard = makeCard('Link behavior', 'Marker and alternate editor options.', '4 options');

    const linkRows = [
      {
        key: 'markerOnCopy',
        title: 'Copy permalink',
        desc: 'Add marker to copied links.'
      },
      {
        key: 'markerOnOpenNewTab',
        title: 'Open here in new tab',
        desc: 'Keep marker when opening a new tab.'
      },
      {
        key: 'markerOnRefresh',
        title: 'Refresh here',
        desc: 'Keep marker after refresh.'
      },
      {
        key: 'showBetaButton',
        title: 'Show Beta/Prod button',
        desc: 'Show the shortcut to the other editor environment when available.'
      }
    ];

    for (const def of linkRows) {
      const pill = createIosToggle(!!st[def.key], (isOn) => {
        const next = loadPermalinkSettings();
        next[def.key] = !!isOn;
        savePermalinkSettings(next);
        if (def.key === 'showBetaButton') {
          try { closeAllMenus(); } catch {}
        }
        toast('Saved: link settings');
      });

      linkCard.body.appendChild(makeSettingRow({
        title: def.title,
        desc: def.desc,
        control: pill,
        onRowClick: () => { try { pill.click(); } catch {} }
      }));
    }

    wrap.appendChild(linkCard.card);

    const appearanceCard = makeCard('Appearance', 'Follows the current WME theme.', 'UI');

    const motionBtn = createIosToggle(!!st.reducedMotion, (isOn) => {
      const next = loadPermalinkSettings();
      next.reducedMotion = !!isOn;
      savePermalinkSettings(next);
      applyLiveRcAppearance();
      toast('Saved: appearance');
    });

    appearanceCard.body.appendChild(makeSettingRow({
      title: 'Reduced Motion',
      desc: 'Less movement on hover.',
      control: motionBtn,
      onRowClick: () => { try { motionBtn.click(); } catch {} }
    }));

    wrap.appendChild(appearanceCard.card);
    return wrap;
  }



