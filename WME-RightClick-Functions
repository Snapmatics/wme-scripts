  }


  function createIosToggle(isOn, onToggle) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'wmeRcIosToggle' + (isOn ? ' is-on' : '');
    btn.setAttribute('aria-pressed', isOn ? 'true' : 'false');
    btn.addEventListener('click', () => {
      const next = !btn.classList.contains('is-on');
      btn.classList.toggle('is-on', next);
      btn.setAttribute('aria-pressed', next ? 'true' : 'false');
      onToggle(next, btn);
    });
    return btn;
  }

  function createRcDropdown(options, currentValue, onChange) {
    const wrap = document.createElement('div');
    wrap.className = 'wmeRcSelect';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'wmeRcSelectBtn';
    btn.textContent = options.find(o => o.value === currentValue)?.label || currentValue || '';
    wrap.appendChild(btn);

    const parseRgb = (str) => {
      const m = String(str || '').match(/rgba?\(([^)]+)\)/i);
      if (!m) return null;
      const parts = m[1].split(',').map(v => parseFloat(v.trim()));
      if (parts.length < 3 || parts.some(v => Number.isNaN(v))) return null;
      return { r: parts[0], g: parts[1], b: parts[2], a: parts.length > 3 ? parts[3] : 1 };
    };
    const luminance = (rgb) => {
      if (!rgb) return 0;
      const toLin = (v) => {
        v /= 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      };
      return 0.2126 * toLin(rgb.r) + 0.7152 * toLin(rgb.g) + 0.0722 * toLin(rgb.b);
    };
    const isLightSurface = () => {
      const themedHost = wrap.closest('.wmeRcModal, .wmeRcSideWrap, .wmeRcSideCard, .theme-light, .theme-dark, .wmeRcLight');
      if (themedHost) {
        if (themedHost.classList.contains('theme-light') || themedHost.classList.contains('wmeRcLight')) return true;
        if (themedHost.classList.contains('theme-dark')) return false;
        if (themedHost.closest('.theme-light, .wmeRcLight')) return true;
        if (themedHost.closest('.theme-dark')) return false;
      }
      const lightAncestor = wrap.closest('.theme-light, .wmeRcLight');
      if (lightAncestor) return true;
      const darkAncestor = wrap.closest('.theme-dark');
      if (darkAncestor) return false;
      const cs = getComputedStyle(btn);
      const bg = parseRgb(cs.backgroundColor);
      const fg = parseRgb(cs.color);
      if (bg && bg.a > 0.05) return luminance(bg) > 0.55;
      if (fg) return luminance(fg) < 0.45;
      return false;
    };

    let menu = null;
    let menuLight = false;
    const menuListeners = [];
    const bindMenuListener = (target, type, handler, opts) => {
      try {
        target.addEventListener(type, handler, opts);
        menuListeners.push(() => {
          try { target.removeEventListener(type, handler, opts); } catch {}
        });
      } catch {}
    };
    const cleanupMenuListeners = () => {
      while (menuListeners.length) {
        try { menuListeners.pop()(); } catch {}
      }
    };
    const positionMenu = () => {
      if (!menu) return;
      const rect = btn.getBoundingClientRect();
      const pad = 8;
      menu.style.position = 'fixed';
      menu.style.left = '-9999px';
      menu.style.top = '-9999px';
      menu.style.right = 'auto';
      menu.style.minWidth = Math.max(rect.width, 116) + 'px';
      menu.style.maxWidth = Math.min(220, Math.max(160, window.innerWidth - pad * 2)) + 'px';
      const mRect = menu.getBoundingClientRect();
      let left = rect.left;
      if (left + mRect.width > window.innerWidth - pad) left = Math.max(pad, window.innerWidth - pad - mRect.width);
      let top = rect.bottom + 6;
      if (top + mRect.height > window.innerHeight - pad) {
        const above = rect.top - 6 - mRect.height;
        if (above >= pad) top = above;
        else top = Math.max(pad, window.innerHeight - pad - mRect.height);
      }
      menu.style.left = Math.round(left) + 'px';
      menu.style.top = Math.round(top) + 'px';
    };
    const applyMenuTheme = () => {
      if (!menu) return;
      menuLight = isLightSurface();
      if (menuLight) {
        menu.style.background = '#ffffff';
        menu.style.color = '#111827';
        menu.style.border = '1px solid rgba(40,56,72,.16)';
        menu.style.boxShadow = '0 14px 34px rgba(15,23,42,.14), 0 2px 8px rgba(15,23,42,.08)';
      } else {
        menu.style.background = '#151b26';
        menu.style.color = '#f8fafc';
        menu.style.border = '1px solid rgba(255,255,255,.10)';
        menu.style.boxShadow = '0 14px 34px rgba(0,0,0,.34), 0 2px 8px rgba(0,0,0,.18)';
      }
      menu.style.backdropFilter = 'none';
      menu.style.webkitBackdropFilter = 'none';
      menu.style.opacity = '1';
      menu.style.pointerEvents = 'auto';
      [...menu.querySelectorAll('.wmeRcSelectOpt')].forEach((item) => {
        const setItemState = (hover = false) => {
          const active = item.classList.contains('is-active');
          if (menuLight) {
            item.style.color = active ? '#0f172a' : '#1f2937';
            item.style.webkitTextFillColor = active ? '#0f172a' : '#1f2937';
            item.style.background = hover ? 'rgba(59,130,246,.08)' : (active ? 'rgba(59,130,246,.12)' : 'transparent');
          } else {
            item.style.color = active ? '#ffffff' : '#f3f4f6';
            item.style.webkitTextFillColor = active ? '#ffffff' : '#f3f4f6';
            item.style.background = hover ? 'rgba(255,255,255,.08)' : (active ? 'rgba(255,255,255,.10)' : 'transparent');
          }
        };
        setItemState(false);
        item.onmouseenter = () => setItemState(true);
        item.onmouseleave = () => setItemState(false);
      });
    };

    const closeMenu = () => {
      cleanupMenuListeners();
      if (menu && menu.parentNode) menu.parentNode.removeChild(menu);
      menu = null;
    };
    const onDocDown = (e) => {
      if (!menu) return;
      if (wrap.contains(e.target) || menu.contains(e.target)) return;
      closeMenu();
    };
    const openMenu = () => {
      if (menu) return;
      menu = document.createElement('div');
      menu.className = 'wmeRcSelectMenu';
      for (const opt of options) {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'wmeRcSelectOpt' + (opt.value === currentValue ? ' is-active' : '');
        item.textContent = opt.label;
        item.addEventListener('click', () => {
          currentValue = opt.value;
          btn.textContent = opt.label;
          onChange(opt.value, btn);
          closeMenu();
        });
        menu.appendChild(item);
      }
      document.body.appendChild(menu);
      applyMenuTheme();
      positionMenu();
      bindMenuListener(document, 'mousedown', onDocDown, true);
      bindMenuListener(window, 'resize', positionMenu, { passive: true });
      bindMenuListener(window, 'scroll', positionMenu, true);
      requestAnimationFrame(() => {
        applyMenuTheme();
        positionMenu();
      });
      setTimeout(() => {
        applyMenuTheme();
        positionMenu();
      }, 30);
    };
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (menu) closeMenu(); else openMenu();
    });
    return wrap;
  }

function buildBackupSettingsEditor() {
    const wrap = document.createElement("div");
    wrap.className = 'wmeRcSettingsView';

    let backupMode = 'all';

    const hero = document.createElement('div');
    hero.className = 'wmeRcSideCard wmeRcSettingsHero';
    hero.innerHTML = `
      <div class="wmeRcSettingsIntroTitle">Export & restore</div>
      <div class="wmeRcSettingsIntroSub">Save your pins and preferences before switching browser or account.</div>
    `;
    wrap.appendChild(hero);

    const card = document.createElement("div");
    card.className = 'wmeRcSideCard wmeRcSettingsCard';
    card.innerHTML = `
      <div class="wmeRcSettingsHeader">
        <div class="wmeRcSettingsHeaderRow">
          <div class="wmeRcSideTitle">Backup content</div>
          <span class="wmeRcSettingsBadge">JSON</span>
        </div>
        <div class="wmeRcSideSub">Pick what the backup should include.</div>
      </div>
    `;

    const body = document.createElement('div');
    body.className = 'wmeRcSettingsBody';

    const modeSelect = createRcDropdown([
      { value: 'all', label: 'All data' },
      { value: 'pins', label: 'Pins only' },
      { value: 'settings', label: 'Settings only' },
    ], backupMode, (value) => {
      backupMode = normalizeBackupMode(value);
      updateModeHint();
    });

    const modeRow = document.createElement('div');
    modeRow.className = 'wmeRcSettingRow';
    modeRow.innerHTML = `
      <div class="wmeRcSettingText">
        <div class="wmeRcSettingTitle">Backup content</div>
        <div class="wmeRcSettingDesc">Use All data for a full restore.</div>
      </div>
    `;
    const modeControl = document.createElement('div');
    modeControl.className = 'wmeRcSettingControl is-select';
    modeControl.appendChild(modeSelect);
    modeRow.appendChild(modeControl);
    body.appendChild(modeRow);

    const modeHint = document.createElement('div');
    modeHint.className = 'wmeRcSettingsNote';
    const updateModeHint = () => {
      modeHint.textContent = backupMode === 'pins'
        ? 'Pins only: map pins, folders, and folder state.'
        : backupMode === 'settings'
          ? 'Settings only: saved Right Click preferences.'
          : 'All data: pins, folders, folder state, and settings.';
    };
    updateModeHint();
    body.appendChild(modeHint);

    const actionsCard = document.createElement('div');
    actionsCard.className = 'wmeRcSettingsActionBar';

    const exportBtn = document.createElement('button');
    exportBtn.type = 'button';
    exportBtn.className = 'wmeRcSideNavBtn';
    exportBtn.textContent = 'Download backup';
    exportBtn.addEventListener('click', () => {
      const ok = downloadPinsBackupFile(backupMode);
      toast(ok ? 'Backup downloaded' : 'Backup failed');
    });

    const importBtn = document.createElement('button');
    importBtn.type = 'button';
    importBtn.className = 'wmeRcSideNavBtn';
    importBtn.textContent = 'Import backup';

    const fileInp = document.createElement('input');
    fileInp.type = 'file';
    fileInp.accept = '.json,application/json';
    fileInp.style.display = 'none';

    importBtn.addEventListener('click', () => { try { fileInp.click(); } catch {} });
    fileInp.addEventListener('change', () => {
      const file = fileInp.files && fileInp.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const payload = JSON.parse(String(reader.result || '{}'));
          openImportBackupConflictModal(payload, backupMode);
        } catch {
          toast('Invalid backup file');
        } finally {
          try { fileInp.value = ''; } catch {}
        }
      };
      reader.onerror = () => {
        toast('Failed to read file');
        try { fileInp.value = ''; } catch {}
      };
      reader.readAsText(file);
    });

    actionsCard.appendChild(exportBtn);
    actionsCard.appendChild(importBtn);
    body.appendChild(actionsCard);
    body.appendChild(fileInp);

    card.appendChild(body);
    wrap.appendChild(card);
    return wrap;
  }

function buildLinkSettingsEditor() {
    const st = loadPermalinkSettings();
